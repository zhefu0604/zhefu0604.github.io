<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.news.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% for item in news %}
          <tr>
            <th scope="row" style="width: 120px; vertical-align: top; padding-top: 4px;">{{ item.date | date: "%b %Y" }}</th>
            <td style="padding-top: 4px;">
              {% if item.inline %}
                {{ item.content | markdownify | remove: '<p>' | remove: '</p>' | strip }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% if item.description %}
                  <br><em>{{ item.description }}</em>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No recent news...</p>
  {% endif %}
</div>
