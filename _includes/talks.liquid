<div class="news">
  {% assign talks = site.talks | reverse %}
  {% if talks != blank and talks.size > 0 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% if include.limit and site.talks_display.limit %}
          {% assign talks_limit = site.talks_display.limit %}
        {% else %}
          {% assign talks_limit = talks.size %}
        {% endif %}
        {% for item in talks limit: talks_limit %}
          <tr>
            <th scope="row" style="white-space: nowrap;">
              {% if item.date_end %}
                {{ item.date | date: "%b %-d" }}–{{ item.date_end | date: "%-d, %Y" }}
              {% elsif item.day_unknown %}
                {{ item.date | date: "%b %Y" }}
              {% else %}
                {{ item.date | date: "%b %-d, %Y" }}
              {% endif %}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | strip }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% if item.description %}
                  <br><em>{{ item.description }}</em>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No upcoming talks scheduled...</p>
  {% endif %}
</div>
