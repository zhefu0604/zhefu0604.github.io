<div class="news">
  {% assign talks = site.talks %}
  {% if talks != blank and talks.size > 0 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in talks %}
          <tr>
            <th scope="row" style="white-space: nowrap;">{{ item.date | date: "%b %d, %Y" }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | strip }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% if item.description %}
                  <br><em>{{ item.description }}</em>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No upcoming talks scheduled...</p>
  {% endif %}
</div>
